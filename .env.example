# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# cp .env.example .env

PORT=3000

# 요약 생성용 LLM (Claude Haiku 4.5) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# 기상청 단기예보 — https://www.data.go.kr/data/15084084/openapi.do
KMA_SERVICE_KEY=

# 카카오 로컬(지오코딩) — https://developers.kakao.com
KAKAO_REST_API_KEY=

# ODsay 대중교통 경로 (하루 30건 무료) — https://lab.odsay.com
ODSAY_API_KEY=

# 기본 출발지(집) 좌표
HOME_LAT=
HOME_LON=

# ntfy.sh 푸시 알림 토픽 (추측하기 어려운 문자열로)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# /depart 엔드포인트 보호용 토큰 (아무 긴 임의 문자열)
WEBHOOK_TOKEN=
